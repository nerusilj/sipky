{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Darts CZ",
  "version": "0.1.0",
  "identifier": "cz.dartscz.inspector",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Darts CZ · WebSocket inspektor", "width": 1440, "height": 960, "minWidth": 800, "minHeight": 640 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/icon.png", "icons/icon.ico"] }
}
