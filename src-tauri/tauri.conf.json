{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Šipky",
  "mainBinaryName": "sipky",
  "version": "0.1.9",
  "identifier": "cz.sipky.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "Šipky", "width": 1440, "height": 960, "minWidth": 800, "minHeight": 640,
      "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required" }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws: http:; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.icns", "icons/icon.ico"] }
}
